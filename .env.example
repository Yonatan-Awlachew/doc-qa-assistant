# Copy this file to ".env" and put your real keys in it.

# Embeddings: Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001

# Chat: Groq (OpenAI-compatible). Free key: https://console.groq.com/keys
CHAT_PROVIDER=openai
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_API_KEY=paste-your-groq-key
CHAT_MODEL=llama-3.3-70b-versatile

# To use Gemini for chat instead, replace the 4 CHAT_ lines with:
# CHAT_PROVIDER=gemini
# CHAT_MODEL=gemini-2.5-flash

# IMPORTANT: if you change the EMBEDDING provider or model, rebuild the index:
#   python -m scripts.build_index

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4